{
    "name": "coercive/ajax",
    "type": "library",
    "description": "Coercive Ajax",
    "homepage": "http://coercive.fr",
    "license": "MIT",
    "authors": [
        {
            "name": "Anthony Moral",
            "email": "contact@coercive.fr",
